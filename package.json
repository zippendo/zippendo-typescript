{
  "name": "@zippendo/sdk",
  "version": "1.3.14",
  "description": "Official TypeScript and JavaScript SDK for the Zippendo shipping API: book shipments, print labels and track parcels with PostNord, GLS, DAO, Bring, DHL, DPD, UPS and more.",
  "author": {
    "name": "Zippendo",
    "url": "https://www.zippendo.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zippendo/zippendo-typescript.git"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^4.0 || ^5.0"
  },
  "keywords": [
    "zippendo",
    "shipping",
    "shipping-api",
    "shipping-labels",
    "logistics",
    "parcel",
    "tracking",
    "ecommerce",
    "fulfillment",
    "postnord",
    "gls",
    "dao",
    "bring",
    "dhl",
    "dpd",
    "ups",
    "sdk",
    "api-client"
  ],
  "homepage": "https://www.zippendo.com/docs/sdks/overview"
}
